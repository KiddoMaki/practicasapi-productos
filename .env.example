PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://kiddomaki.github.io

# --- Base de datos ---
# En Render usa DATABASE_URL (lo entrega el servicio de Postgres).
# En local puedes usar DATABASE_URL o las variables DB_* por separado.
DATABASE_URL=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=Productos
# DB_USER=tu_usuario
# DB_PASSWORD=tu_contraseña
DB_SCHEMA=tienda
DB_POOL_MAX=10
# Render exige SSL: pon true en producción
DB_SSL=false
